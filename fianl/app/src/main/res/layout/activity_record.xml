<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:divider="?android:attr/dividerHorizontal"
        android:showDividers="middle"
        android:dividerPadding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textSize="24sp"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:id="@+id/imageProfile"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_profile"
                android:scaleType="centerCrop"
                android:contentDescription="기록 아이콘"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textSize="24sp"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닉네임"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘 날짜"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkPregnant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="임신 여부"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/editWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="현재 체중"
            android:background="@drawable/rounded_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="생리 / 배탈 상태"
            android:background="@drawable/rounded_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editSleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="수면 시간"
            android:background="@drawable/rounded_edittext"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/checkExercise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운동 여부"
            android:minHeight="48dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:id="@+id/layoutPregnantExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#FFF8E1"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="증상 체크"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="입덧 여부 (심함 / 보통 / 없음)" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="부기 여부 (다리, 손 등)" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="배 통증 (쥐/경련)" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="허리 통증" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="두통 / 어지러움" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기타 특이사항 (메모)" />
        </LinearLayout>

        <Button
            android:id="@+id/btnComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="완료하기"
            android:textColor="#000000"
            android:backgroundTint="#FFD600"
            android:textStyle="bold"
            android:textSize="16sp"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />
    </LinearLayout>
</ScrollView>
