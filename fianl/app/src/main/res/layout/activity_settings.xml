<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFD600"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/icon"
            android:contentDescription="로고" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:textColor="#000000" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:divider="?android:attr/dividerHorizontal"
            android:showDividers="middle"
            android:dividerPadding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="앱 정보"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#555555"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="앱 이름: 맘편한 하루"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="버전: 1.0.0"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="개발자: 이서진"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이 앱은 건강과 일상을 편하게 기록하기 위해 제작되었습니다."
                android:textSize="13sp"
                android:textColor="#777777"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="환경 설정"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#555555"
                android:layout_marginBottom="8dp" />

            <Switch
                android:id="@+id/switchNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="알림 받기"
                android:textSize="15sp"
                android:minHeight="48dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <Switch
                android:id="@+id/switchDarkMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="다크 모드"
                android:textSize="15sp"
                android:minHeight="48dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <Switch
                android:id="@+id/switchAutoSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="기록 자동 저장"
                android:textSize="15sp"
                android:minHeight="48dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <Switch
                android:id="@+id/switchAlwaysShowPregnant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="항상 임신 항목 표시"
                android:textSize="15sp"
                android:minHeight="48dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
